# ============================================================
#  M3U8-Downloader  .gitignore
#  原则：源码与打包配置入库；虚拟环境、构建产物、运行输出不入库
# ============================================================

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo

# ---------- Python 虚拟环境 ----------
.venv/
venv/
env/
ENV/
python_env/

# ---------- Python 字节码缓存 ----------
__pycache__/
*.py[cod]
*$py.class

# ---------- 类型检查 / 测试 / 覆盖率缓存 ----------
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---------- PyInstaller 构建产物 ----------
build/
dist/
localpycs/
*.manifest
*.egg-info/
*.spec.bak
# 说明：*.spec 是打包配置，属于源码，故意不忽略

# ---------- 程序运行输出（M3U8 下载器生成） ----------
# 临时分片目录与分片文件
TS/
*.ts
*.m4s
# 合并后的视频
*.mp4
# 原子写盘的中间文件
*.part

# ---------- 日志 ----------
*.log
pip-log.txt

# ---------- AI 助手工作目录（本地数据，不入库） ----------
.workbuddy/

# ---------- 操作系统垃圾文件 ----------
.DS_Store
._*
Thumbs.db
desktop.ini

# ---------- 其他 ----------
.python-version
